# ============================================================
# EthioPrep — Server Environment Configuration
# ============================================================

PORT=3001
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ethioprep_dev?schema=public"

# Session / JWT Secret (minimum 32 random characters in production)
SESSION_SECRET="ethioprep-super-secret-development-key-32chars"

# Client URL (for CORS credentials)
CLIENT_URL="http://localhost:5173"

